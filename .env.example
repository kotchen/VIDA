# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom OpenAI Base URL (for proxy or alternative endpoints)
OPENAI_BASE_URL=https://api.openai.com/v1

# Server Configuration (Optional)
HOST=0.0.0.0
PORT=8000

# Whisper Model Configuration (Optional)
# Options: tiny, base, small, medium, large
WHISPER_MODEL_SIZE=base

# Local upload size limit in MB (optional; Docker Compose passes this through)
UPLOAD_MAX_MB=200

# VIDA 2.0 Configuration
V2_MAX_CONCURRENT_JOBS=2
V2_UPLOAD_MAX_GB=5
# Required for VIDA 2.0. Generate once with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Store it outside source control and back it up with data/v2/. Losing it makes
# saved Provider credentials unrecoverable. Never rotate it without re-encrypting them.
VIDA_PROFILE_MASTER_KEY=
# Production must use one application process. Do not configure multiple
# Uvicorn workers; v2 SSE is process-local and the internal job pool handles concurrency.
